
import { track } from "ripple"

export default component FilterTop(){

    const actives = track("")
    const isActive = (name: String) => {
        return @actives === name.toLowerCase()
    }

    const setFilter = (name: string)=> {
        @actives = name
    }
    const filters = [
        {name: "Location", icon: "ri-map-pin-line", action: ()=> setFilter("Location"),},
        {name: "Pricing", icon: "ri-currency-line", action: ()=> setFilter("Pricing")},
        {name: "Rating", icon: "ri-star-line", action: ()=> setFilter("Rating")},
    ]

    <div class="px-4 z-20 dark:text-gray-100 dark:bg-black flex justify-between py-2 bg-white h-14 sticky top-[12vh] border-b-2 border-gray-300 w-full ">
        <div class="flex gap-4  ">
            for (const it of filters ){
                <button onClick={it.action} class={` flex gap-2 items-center transition-all border rounded-md px-3  ${ @actives === it.name ? "bg-[#0305e2] text-white  border-0 " : "" } cursor-pointer  `}>
                   <i class={` ${it.icon} `} ></i>
                    {it.name}
                </button>
            }      

        </div>
<button  class={` flex gap-2 items-center transition-all border rounded-md px-3  ${ @actives === "-" ? "bg-blue-500 border-0 " : "" } cursor-pointer  `}>
                   <i class="ri-filter-2-line"></i>
                    {"All Filters"}
                </button>
    </div>
}